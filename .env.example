# Copy to .env and change the secret. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Bind address and port
HOST=127.0.0.1
PORT=8000
# Optional self-signed HTTPS (needs openssl on PATH; cert stored in certs/)
# USE_SSL=1
